# env files (contain secrets — DO NOT COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# Playwright output (npm run test:e2e)
test-results/
playwright-report/

# Verse share images are generated at build time (`npm run og:verses`).
public/og/verse/

# fetched font cache (regenerated by scripts/generate-og-images.ts)
scripts/.fonts/

# Chapter shards generated by scripts/shard-scriptures-full.ts (prebuild)
# Keep full-book JSON (public/data/scriptures-full/*.json); ignore per-chapter shards.
public/data/scriptures-full/*/

# Temporary scratch scripts and wisdomlib extraction HTML caches
scripts/_tmp_*
scripts/cache/*

# local logs
*.log

# OCR/extracted source material: kept locally, not redistributed (see scripts/README.md)
/sources/
.ocr-cache/
/data/quality-report.json
tools/granth-ocr/work/
tools/granth-ocr/**/__pycache__/

# Python virtual environment & bytecode
.venv/
__pycache__/
*.py[cod]
*$py.class
**/*.pyc

# OCR local workspace and batch outputs
ocr_workspace/
ocr_output/

# Scratch workspace
scratch/

# Local copies of Gita Press books (large, copyrighted; sources only)
data/sources-local/gitapress_*
data/sources-local/gitapress_official_epubs/

# Workspace-local tsx/node temp dir (sandbox TMPDIR workaround)
.tmp-tsx/

# Extraction tokens and cookies
scripts/*session_token*
scripts/*cookies*
