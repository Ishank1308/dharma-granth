# Response headers for Cloudflare Pages (docs/deploy-cloudflare.md).
# GitHub Pages ignores this file.

/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; media-src 'self' data: blob:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Fingerprinted build assets never change.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# This Next export has no files here. The rules keep a later framework from inheriting the HTML cache.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Search index and shards are rebuilt with each deploy: short browser cache, long edge cache.
/search/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# The service worker must always be revalidated so updates reach users.
/sw.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Share images and fonts change rarely; a week, then revalidate.
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# API discovery (RFC 9727): exact content types so automated scanners pass.
/.well-known/api-catalog
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: application/linkset+json
/openapi.json
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: application/openapi+json

# Notes on the policy:
# - `! Cache-Control` removes the HTML rule's value so asset rules do not merge with it.
# - /assets/* and /_astro/* from other frameworks do not exist in this Next export.
# - 'unsafe-inline' for scripts is required: the static Next export injects
#   inline bootstrap scripts and cannot use per-request nonces.
# - cloudflareinsights.com is allowed so Cloudflare Web Analytics can be
#   switched on without editing this file.
# - HSTS has no `preload`: submitting the domain to browsers' preload lists is
#   hard to undo; add it only once every subdomain is permanently HTTPS.
