{
 "note": "Sanskrit sutra text only, read from the Gita Press Gorakhpur edition (Narad-Bhakti-Sutra evam Shandilya-Bhakti-Sutra) and proofread against the page images. The Hindi gloss is not reproduced.",
 "chapters": [
  {
   "number": 1,
   "title": "नारद-भक्ति-सूत्र",
   "verses": [
    {
     "number": 1,
     "sanskrit": "अथातो भक्तिं व्याख्यास्यामः ॥ १ ॥"
    },
    {
     "number": 2,
     "sanskrit": "सा त्वस्मिन् परमप्रेमरूपा ॥ २ ॥"
    },
    {
     "number": 3,
     "sanskrit": "अमृतस्वरूपा च ॥ ३ ॥"
    },
    {
     "number": 4,
     "sanskrit": "यल्लब्ध्वा पुमान् सिद्धो भवति, अमृतो भवति, तृप्तो भवति ॥ ४ ॥"
    },
    {
     "number": 5,
     "sanskrit": "यत्प्राप्य न किञ्चिद्वाञ्छति, न शोचति, न द्वेष्टि, न रमते, नोत्साही भवति ॥ ५ ॥"
    },
    {
     "number": 6,
     "sanskrit": "यज्ज्ञात्वा मत्तो भवति, स्तब्धो भवति, आत्मारामो भवति ॥ ६ ॥"
    },
    {
     "number": 7,
     "sanskrit": "सा न कामयमाना निरोधरूपत्वात् ॥ ७ ॥"
    },
    {
     "number": 8,
     "sanskrit": "निरोधस्तु लोकवेदव्यापारन्यासः ॥ ८ ॥"
    },
    {
     "number": 9,
     "sanskrit": "तस्मिन्ननन्यता तद्विरोधिषूदासीनता च ॥ ९ ॥"
    },
    {
     "number": 10,
     "sanskrit": "अन्याश्रयाणां त्यागोऽनन्यता ॥ १० ॥"
    },
    {
     "number": 11,
     "sanskrit": "लोके वेदेषु तदनुकूलाचरणं तद्विरोधिषूदासीनता ॥ ११ ॥"
    },
    {
     "number": 12,
     "sanskrit": "भवतु निश्चयदार्ढ्यादूर्ध्वं शास्त्ररक्षणम् ॥ १२ ॥"
    },
    {
     "number": 13,
     "sanskrit": "अन्यथा पातित्याशङ्कया ॥ १३ ॥"
    },
    {
     "number": 14,
     "sanskrit": "लोकोऽपि तावदेव किन्तु भोजनादिव्यापारस्त्वाशरीरधारणावधि ॥ १४ ॥"
    },
    {
     "number": 15,
     "sanskrit": "तल्लक्षणानि वाच्यन्ते नानामतभेदात् ॥ १५ ॥"
    },
    {
     "number": 16,
     "sanskrit": "पूजादिष्वनुराग इति पाराशर्यः ॥ १६ ॥"
    },
    {
     "number": 17,
     "sanskrit": "कथादिष्विति गर्गः ॥ १७ ॥"
    },
    {
     "number": 18,
     "sanskrit": "आत्मरत्यविरोधेनेति शाण्डिल्यः ॥ १८ ॥"
    },
    {
     "number": 19,
     "sanskrit": "नारदस्तु तदर्पिताखिलाचारता तद्विस्मरणे परमव्याकुलतेति ॥ १९ ॥"
    },
    {
     "number": 20,
     "sanskrit": "अस्त्येवमेवम् ॥ २० ॥"
    },
    {
     "number": 21,
     "sanskrit": "यथा व्रजगोपिकानाम् ॥ २१ ॥"
    },
    {
     "number": 22,
     "sanskrit": "तत्रापि न माहात्म्यज्ञानविस्मृत्यपवादः ॥ २२ ॥"
    },
    {
     "number": 23,
     "sanskrit": "तद्विहीनं जाराणामिव ॥ २३ ॥"
    },
    {
     "number": 24,
     "sanskrit": "नास्त्येव तस्मिंस्तत्सुखसुखित्वम् ॥ २४ ॥"
    },
    {
     "number": 25,
     "sanskrit": "सा तु कर्मज्ञानयोगेभ्योऽप्यधिकतरा ॥ २५ ॥"
    },
    {
     "number": 26,
     "sanskrit": "फलरूपत्वात् ॥ २६ ॥"
    },
    {
     "number": 27,
     "sanskrit": "ईश्वरस्याप्यभिमानद्वेषित्वाद् दैन्यप्रियत्वाच्च ॥ २७ ॥"
    },
    {
     "number": 28,
     "sanskrit": "तस्या ज्ञानमेव साधनमित्येके ॥ २८ ॥"
    },
    {
     "number": 29,
     "sanskrit": "अन्योन्याश्रयत्वमित्यन्ये ॥ २९ ॥"
    },
    {
     "number": 30,
     "sanskrit": "स्वयं फलरूपतेति ब्रह्मकुमाराः ॥ ३० ॥"
    },
    {
     "number": 31,
     "sanskrit": "राजगृहभोजनादिषु तथैव दृष्टत्वात् ॥ ३१ ॥"
    },
    {
     "number": 32,
     "sanskrit": "न तेन राजपरितोषः क्षुधाशान्तिर्वा ॥ ३२ ॥"
    },
    {
     "number": 33,
     "sanskrit": "तस्मात्सैव ग्राह्या मुमुक्षुभिः ॥ ३३ ॥"
    },
    {
     "number": 34,
     "sanskrit": "तस्याः साधनानि गायन्त्याचार्याः ॥ ३४ ॥"
    },
    {
     "number": 35,
     "sanskrit": "तत्तु विषयत्यागात् सङ्गत्यागाच्च ॥ ३५ ॥"
    },
    {
     "number": 36,
     "sanskrit": "अव्यावृतभजनात् ॥ ३६ ॥"
    },
    {
     "number": 37,
     "sanskrit": "लोकेऽपि भगवद्गुणश्रवणकीर्तनात् ॥ ३७ ॥"
    },
    {
     "number": 38,
     "sanskrit": "मुख्यतस्तु महत्कृपयैव भगवत्कृपालेशाद्वा ॥ ३८ ॥"
    },
    {
     "number": 39,
     "sanskrit": "महत्सङ्गस्तु दुर्लभोऽगम्योऽमोघश्च ॥ ३९ ॥"
    },
    {
     "number": 40,
     "sanskrit": "लभ्यतेऽपि तत्कृपयैव ॥ ४० ॥"
    },
    {
     "number": 41,
     "sanskrit": "तस्मिंस्तज्जने भेदाभावात् ॥ ४१ ॥"
    },
    {
     "number": 42,
     "sanskrit": "तदेव साध्यतां तदेव साध्यताम् ॥ ४२ ॥"
    },
    {
     "number": 43,
     "sanskrit": "दुःसङ्गः सर्वथैव त्याज्यः ॥ ४३ ॥"
    },
    {
     "number": 44,
     "sanskrit": "कामक्रोधमोहस्मृतिभ्रंशबुद्धिनाशसर्वनाशकारणत्वात् ॥ ४४ ॥"
    },
    {
     "number": 45,
     "sanskrit": "तरङ्गायिता अपीमे सङ्गात्समुद्रायन्ति ॥ ४५ ॥"
    },
    {
     "number": 46,
     "sanskrit": "कस्तरति कस्तरति मायाम्? यः सङ्गांस्त्यजति, यो महानुभावं सेवते, निर्ममो भवति ॥ ४६ ॥"
    },
    {
     "number": 47,
     "sanskrit": "यो विविक्तस्थानं सेवते, यो लोकबन्धमुन्मूलयति, निस्त्रैगुण्यो भवति, योगक्षेमं त्यजति ॥ ४७ ॥"
    },
    {
     "number": 48,
     "sanskrit": "यः कर्मफलं त्यजति, कर्माणि संन्यस्यति, ततो निर्द्वन्द्वो भवति ॥ ४८ ॥"
    },
    {
     "number": 49,
     "sanskrit": "वेदानपि संन्यस्यति, केवलमविच्छिन्नानुरागं लभते ॥ ४९ ॥"
    },
    {
     "number": 50,
     "sanskrit": "स तरति स तरति स लोकांस्तारयति ॥ ५० ॥"
    },
    {
     "number": 51,
     "sanskrit": "अनिर्वचनीयं प्रेमस्वरूपम् ॥ ५१ ॥"
    },
    {
     "number": 52,
     "sanskrit": "मूकास्वादनवत् ॥ ५२ ॥"
    },
    {
     "number": 53,
     "sanskrit": "प्रकाशते क्वापि पात्रे ॥ ५३ ॥"
    },
    {
     "number": 54,
     "sanskrit": "गुणरहितं कामनारहितं प्रतिक्षणवर्धमानमविच्छिन्नं सूक्ष्मतरमनुभवरूपम् ॥ ५४ ॥"
    },
    {
     "number": 55,
     "sanskrit": "तत्प्राप्य तदेवावलोकयति, तदेव शृणोति, तदेव भाषयति, तदेव चिन्तयति ॥ ५५ ॥"
    },
    {
     "number": 56,
     "sanskrit": "गौणी त्रिधा गुणभेदादार्तादिभेदाद्वा ॥ ५६ ॥"
    },
    {
     "number": 57,
     "sanskrit": "उत्तरस्मादुत्तरस्मात्पूर्वपूर्वा श्रेयाय भवति ॥ ५७ ॥"
    },
    {
     "number": 58,
     "sanskrit": "अन्यस्मात् सौलभ्यं भक्तौ ॥ ५८ ॥"
    },
    {
     "number": 59,
     "sanskrit": "प्रमाणान्तरस्यानपेक्षत्वात् स्वयंप्रमाणत्वात् ॥ ५९ ॥"
    },
    {
     "number": 60,
     "sanskrit": "शान्तिरूपात्परमानन्दरूपाच्च ॥ ६० ॥"
    },
    {
     "number": 61,
     "sanskrit": "लोकहानौ चिन्ता न कार्या निवेदितात्मलोकवेदत्वात् ॥ ६१ ॥"
    },
    {
     "number": 62,
     "sanskrit": "न तदसिद्धौ लोकव्यवहारो हेयः किन्तु फलत्यागस्तत्साधनं च कार्यमेव ॥ ६२ ॥"
    },
    {
     "number": 63,
     "sanskrit": "स्त्रीधननास्तिकवैरिचरित्रं न श्रवणीयम् ॥ ६३ ॥"
    },
    {
     "number": 64,
     "sanskrit": "अभिमानदम्भादिकं त्याज्यम् ॥ ६४ ॥"
    },
    {
     "number": 65,
     "sanskrit": "तदर्पिताखिलाचारः सन् कामक्रोधाभिमानादिकं तस्मिन्नेव करणीयम् ॥ ६५ ॥"
    },
    {
     "number": 66,
     "sanskrit": "त्रिरूपभङ्गपूर्वकं नित्यदासनित्यकान्ताभजनात्मकं वा प्रेमैव कार्यम्, प्रेमैव कार्यम् ॥ ६६ ॥"
    },
    {
     "number": 67,
     "sanskrit": "भक्ता एकान्तिनो मुख्याः ॥ ६७ ॥"
    },
    {
     "number": 68,
     "sanskrit": "कण्ठावरोधरोमाञ्चाश्रुभिः परस्परं लपमानाः पावयन्ति कुलानि पृथिवीं च ॥ ६८ ॥"
    },
    {
     "number": 69,
     "sanskrit": "तीर्थीकुर्वन्ति तीर्थानि, सुकर्मीकुर्वन्ति कर्माणि, सच्छास्त्रीकुर्वन्ति शास्त्राणि ॥ ६९ ॥"
    },
    {
     "number": 70,
     "sanskrit": "तन्मयाः ॥ ७० ॥"
    },
    {
     "number": 71,
     "sanskrit": "मोदन्ते पितरो नृत्यन्ति देवताः सनाथा चेयं भूर्भवति ॥ ७१ ॥"
    },
    {
     "number": 72,
     "sanskrit": "नास्ति तेषु जातिविद्यारूपकुलधनक्रियादिभेदः ॥ ७२ ॥"
    },
    {
     "number": 73,
     "sanskrit": "यतस्तदीयाः ॥ ७३ ॥"
    },
    {
     "number": 74,
     "sanskrit": "वादो नावलम्ब्यः ॥ ७४ ॥"
    },
    {
     "number": 75,
     "sanskrit": "बाहुल्यावकाशादनियतत्वाच्च ॥ ७५ ॥"
    },
    {
     "number": 76,
     "sanskrit": "भक्तिशास्त्राणि मननीयानि तदुद्बोधककर्माण्यपि करणीयानि ॥ ७६ ॥"
    },
    {
     "number": 77,
     "sanskrit": "सुखदुःखेच्छालाभादित्यक्ते काले प्रतीक्ष्यमाणे क्षणार्द्धमपि व्यर्थं न नेयम् ॥ ७७ ॥"
    },
    {
     "number": 78,
     "sanskrit": "अहिंसासत्यशौचदयास्तिक्यादिचारित्र्याणि परिपालनीयानि ॥ ७८ ॥"
    },
    {
     "number": 79,
     "sanskrit": "सर्वदा सर्वभावेन निश्चिन्तितैर्भगवानेव भजनीयः ॥ ७९ ॥"
    },
    {
     "number": 80,
     "sanskrit": "स कीर्त्यमानः शीघ्रमेवाविर्भवति अनुभावयति च भक्तान् ॥ ८० ॥"
    },
    {
     "number": 81,
     "sanskrit": "त्रिसत्यस्य भक्तिरेव गरीयसी भक्तिरेव गरीयसी ॥ ८१ ॥"
    },
    {
     "number": 82,
     "sanskrit": "गुणमाहात्म्यासक्तिरूपासक्तिपूजासक्तिस्मरणासक्तिदास्यासक्तिसख्यासक्तिकान्तासक्तिवात्सल्यासक्त्यात्मनिवेदनासक्तितन्मयतासक्तिपरमविरहासक्तिरूपाप्येका एकादशधा भवति ॥ ८२ ॥"
    },
    {
     "number": 83,
     "sanskrit": "इत्येवं वदन्ति जनजल्पनिर्भया एकमताः कुमारव्यासशुकशाण्डिल्यगर्गविष्णुकौण्डिन्यशेषोद्धवारुणिबलिहनुमद्विभीषणादयो भक्त्याचार्याः ॥ ८३ ॥"
    },
    {
     "number": 84,
     "sanskrit": "य इदं नारदप्रोक्तं शिवानुशासनं विश्वसिति श्रद्धत्ते स प्रेष्ठं लभते स प्रेष्ठं लभत इति ॥ ८४ ॥"
    }
   ]
  }
 ]
}
