    {
     "number": 37,
     "sanskrit": "प्रकृत्यन्तरालादवैकार्यं चित्सत्त्वेनानुवर्तमानात् ॥ ३७ ॥"
    },
    {
     "number": 38,
     "sanskrit": "तत्प्रतिष्ठा गृहपीठवत् ॥ ३८ ॥"
    },
    {
     "number": 39,
