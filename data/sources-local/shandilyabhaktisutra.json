   "title": "प्रथम अध्याय",
   "verses": [
    {
     "number": 1,
     "sanskrit": "अथातो भक्तिजिज्ञासा ॥ १ ॥"
    },
    {
     "number": 2,
     "sanskrit": "सा परानुरक्तिरीश्वरे ॥ २ ॥"
    },
    {
     "number": 3,
     "sanskrit": "तत्संस्थस्यामृतत्वोपदेशात् ॥ ३ ॥"
    },
    {
     "number": 4,
     "sanskrit": "ज्ञानमिति चेन्न द्विषतोऽपि ज्ञानस्य तदसंस्थितेः ॥ ४ ॥"
    },
    {
     "number": 5,
     "sanskrit": "तयोपक्षयाच्च ॥ ५ ॥"
    },
    {
     "number": 6,
     "sanskrit": "द्वेषप्रतिपक्षभावाद्रसशब्दाच्च रागः ॥ ६ ॥"
    },
    {
     "number": 7,
     "sanskrit": "न क्रिया कृत्यनपेक्षणाज्ज्ञानवत् ॥ ७ ॥"
    },
    {
     "number": 8,
     "sanskrit": "अत एव फलानन्त्यम् ॥ ८ ॥"
    },
    {
     "number": 9,
     "sanskrit": "तद्वतः प्रपत्तिशब्दाच्च न ज्ञानमितरप्रपत्तिवत् ॥ ९ ॥"
    },
    {
     "number": 10,
     "sanskrit": "सा मुख्येतरापेक्षितत्वात् ॥ १० ॥"
    },
    {
     "number": 11,
     "sanskrit": "प्रकरणाच्च ॥ ११ ॥"
    },
    {
     "number": 12,
     "sanskrit": "दर्शनफलमिति चेन्न तेन व्यवधानात् ॥ १२ ॥"
    },
    {
     "number": 13,
     "sanskrit": "दृष्टत्वाच्च ॥ १३ ॥"
    },
    {
     "number": 14,
     "sanskrit": "अत एव तदभावाद्वल्लवीनाम् ॥ १४ ॥"
    },
    {
     "number": 15,
     "sanskrit": "भक्त्या जानातीति चेन्नाभिज्ञप्त्या साहाय्यात् ॥ १५ ॥"
    },
    {
     "number": 16,
     "sanskrit": "प्रागुक्तं च ॥ १६ ॥"
    },
    {
     "number": 17,
     "sanskrit": "एतेन विकल्पोऽपि प्रत्युक्तः ॥ १७ ॥"
    },
    {
     "number": 18,
     "sanskrit": "देवभक्तिरितरस्मिन् साहचर्यात् ॥ १८ ॥"
    },
    {
     "number": 19,
     "sanskrit": "योगस्तूभयार्थमपेक्षणात् प्रयाजवत् ॥ १९ ॥"
    },
    {
     "number": 20,
     "sanskrit": "गौण्या तु समाधिसिद्धिः ॥ २० ॥"
    },
    {
     "number": 21,
     "sanskrit": "हेया रागत्वादिति चेन्नोत्तमास्पदत्वात् सङ्गवत् ॥ २१ ॥"
    },
    {
     "number": 22,
     "sanskrit": "तदेव कर्मिज्ञानियोगिभ्य आधिक्यशब्दात् ॥ २२ ॥"
    },
    {
     "number": 23,
     "sanskrit": "प्रश्ननिरूपणाभ्यामाधिक्यसिद्धेः ॥ २३ ॥"
    },
    {
     "number": 24,
     "sanskrit": "नैव श्रद्धा तु साधारण्यात् ॥ २४ ॥"
