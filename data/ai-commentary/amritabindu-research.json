  "1:2": {
    "status": "approved",
    "science": "ध्यान और प्रसन्नता पर हुए अध्ययनों में यह देखा गया है कि भटकता हुआ मन प्रायः अपेक्षाकृत कम प्रसन्न रहता है, जबकि वर्तमान कार्य में लगा मन अधिक सन्तुष्ट। यह एक समानता है, श्लोक का प्रमाण नहीं।"
  },
  "1:8": {
    "status": "approved",
    "science": "ॐ के लम्बे उच्चारण पर हुए कुछ अध्ययन संकेत देते हैं कि इससे श्वास धीमी होती है और मन कुछ शान्त होता है; इसकी सीमा पर शोध प्रारम्भिक है। यह एक समानता है, श्लोक का वैज्ञानिक प्रमाण नहीं।"
  },
  "1:12": {
    "status": "approved",
    "science": "मन्त्र-जप पर हुए कुछ अध्ययन संकेत देते हैं कि नियमित और लयबद्ध जप श्वास और हृदयगति को नियमित करने में सहायक हो सकता है; इस विषय पर शोध सीमित है। यह एक समानता है, श्लोक का प्रमाण नहीं।"
  },
